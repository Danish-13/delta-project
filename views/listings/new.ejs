<% layout("/layouts/boilerplate") -%>
<div class="row">
  <div class="col-8 offset-2">
    <h3 class="mt-3">Create A New Listing</h3>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <lable for="title" class="form-lable">Title</lable>
        <input
          name="listing[title]"
          placeholder="Enter Title"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter the Title</div>
      </div>

      <div class="mb-3">
        <lable for="description" class="form-lable">Description</lable>
        <textarea
          name="listing[description]"
          placeholder="Enter Description"
          type="text"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter the description</div>
      </div>

      <div class="mb-3">
        <lable for="image" class="form-lable">Upload Listing Image</lable>
        <input
          name="listing[image]"
          placeholder="Upload Image"
          type="file"
          class="form-control"
          required
        />
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <lable for="Price" class="form-lable">Price</lable>
          <input
            name="listing[price]"
            placeholder="Enter Price"
            type="number"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid Price</div>
        </div>

        <div class="mb-3 col-md-8">
          <lable for="Counrty" class="form-lable">Counrty</lable>
          <input
            name="listing[country]"
            placeholder="Enter country name"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter the Country</div>
        </div>
      </div>

      <div class="mb-3">
        <lable for="location" class="form-lable">Location</lable>
        <input
          name="listing[location]"
          placeholder="Enter Location"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter the location</div>
      </div>

      <button class="btn btn-dark add-btn mt-3">Add</button>
      <br /><br />
    </form>
  </div>
</div>
